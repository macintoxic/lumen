<idea-plugin>
    <!-- id/name/version/description/sinceBuild vêm do build.gradle.kts (intellijPlatform.pluginConfiguration) -->
    <vendor>CeuTenant</vendor>

    <!-- com.intellij.modules.platform é suficiente — só mexe no editor/gutter
         a partir de um XML já existente em disco, nada de módulo específico
         de C#/.NET/backend ReSharper. -->
    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="com.ceutenant.lumen.startup.CoverageStartupActivity"/>
        <editorFactoryListener implementation="com.ceutenant.lumen.listener.CoverageEditorFactoryListener"/>
        <notificationGroup id="Lumen" displayType="BALLOON"/>
        <!-- id="Coverage" colide com o toolwindow nativo do Rider (dotCover
             embutido já registra esse id) — "Code Coverage" é o texto pedido
             pro botão lateral e também precisa ser distinto do nativo. -->
        <toolWindow id="Code Coverage"
                    anchor="right"
                    icon="AllIcons.Toolwindows.ToolWindowCoverage"
                    factoryClass="com.ceutenant.lumen.ui.CoverageToolWindowFactory"/>
    </extensions>

    <actions>
        <action id="Lumen.ReloadCoverage"
                class="com.ceutenant.lumen.actions.ReloadCoverageAction"
                text="Reload Coverage Report"
                description="Reimporta o coverage.cobertura.xml mais recente do projeto e repinta os editores abertos">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
            <add-to-group group-id="ToolsMenu" anchor="first"/>
        </action>
    </actions>
</idea-plugin>
